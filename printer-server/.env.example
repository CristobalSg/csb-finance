SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_la_service_role_key_solo_en_servidor

FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173
PRINTER_SERVER_HOST=127.0.0.1
PRINTER_SERVER_PORT=3001

# Windows: envia ESC/POS RAW por el spooler usando el nombre exacto de la impresora.
PRINTER_CONNECTION=windows
PRINTER_NAME=POS-80

# Red: usa estos valores si PRINTER_CONNECTION=network.
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# USB directo: opcional si quieres fijar vendor/product id.
PRINTER_USB_VENDOR_ID=
PRINTER_USB_PRODUCT_ID=
PRINTER_ENCODING=CP850

# Impresion de logo y ajustes de papel.
PRINT_RECEIPT_LOGO=true
RECEIPT_LOGO_PATH=
PRINTER_LINE_SPACING=24
PRINTER_CUT_FEED_LINES=4
PRINTER_EVENT_CUT_FEED_LINES=4
RECEIPT_LOGO_WIDTH_80MM=384
RECEIPT_LOGO_WIDTH_56MM=256
HORIZONTAL_RECEIPT_LOGO_WIDTH_56MM=300
THANKS_IMAGE_WIDTH_80MM=360
THANKS_IMAGE_WIDTH_56MM=260
RECEIPT_PAPER_DOTS_80MM=576
RECEIPT_PAPER_DOTS_56MM=384
RECEIPT_TOP_FEED_LINES=0
RECEIPT_LOGO_BOTTOM_FEED_LINES=0
